formulas:
  Links count: (file.links.length) + (file.backlinks.length)
properties:
  formula.Links count:
    displayName: Linked count
views:
  - type: table
    name: Table
    filters:
      and:
        - file.folder == "01_Input/Inbox"
        - formula["Links count"] < 1
    order:
      - file.name
      - file.tags
      - formula.Links count
      - file.ctime
    sort:
      - property: file.ctime
        direction: DESC
      - property: file.tags
        direction: ASC
  - type: cards
    name: Cards
    cardSize: 180
    image: note.title
    imageAspectRatio: 0.4
